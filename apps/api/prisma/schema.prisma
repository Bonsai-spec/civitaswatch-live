generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  fullName            String
  email               String               @unique
  passwordHash        String
  role                String
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  incidentsCreated    Incident[]
  patrolSessions      PatrolSession[]
  prePatrolChecklists PrePatrolChecklist[]
  sectorAccess        UserSectorAccess[]
}

model PrePatrolChecklist {
  id                   String          @id @default(uuid())
  userId               String
  patrolDate           DateTime
  vehicleInspected     Boolean         @default(false)
  safetyCheckCompleted Boolean         @default(false)
  notes                String?
  completedAt          DateTime        @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  callSignConfirmed    Boolean         @default(false)
  radioChecked         Boolean         @default(false)
  vehicleFuelLevel     String?
  vestChecked          Boolean         @default(false)
  patrolSessions       PatrolSession[]
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, patrolDate])
}

model Vehicle {
  id             String          @id @default(uuid())
  make           String
  type           String
  registration   String          @unique
  colour         String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  patrolSessions PatrolSession[]
}

model PatrolSession {
  id           String              @id @default(uuid())
  userId       String
  vehicleId    String
  checklistId  String?
  sector       String
  startTime    DateTime            @default(now())
  endTime      DateTime?
  startKm      Int
  endKm        Int?
  totalKm      Int?
  summary      String?
  status       String              @default("ACTIVE")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  editedAt     DateTime?
  editedBy     String?
  editCount    Int                 @default(0)
  isLocked     Boolean             @default(false)
  incidents    Incident[]
  patrolEvents PatrolEvent[]
  checklist    PrePatrolChecklist? @relation(fields: [checklistId], references: [id])
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle      Vehicle             @relation(fields: [vehicleId], references: [id])

  @@index([userId, startTime])
  @@index([vehicleId, startTime])
  @@index([sector])
  @@index([status])
}

model PatrolReportAuditLog {
  id           String   @id
  patrolId     String
  editedBy     String
  editedByRole String
  fieldName    String
  oldValue     String?
  newValue     String?
  editReason   String
  createdAt    DateTime @default(now())
}

model Incident {
  id              String         @id @default(uuid())
  incidentCode    String         @unique
  title           String
  description     String?
  sector          String
  status          String
  severity        String
  source          String
  linkedPatrolId  String?
  createdByUserId String
  reportedAt      DateTime
  occurredAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  incidentType    String?
  street          String?
  suburb          String?
  createdBy       User           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  linkedPatrol    PatrolSession? @relation(fields: [linkedPatrolId], references: [id])
  patrolEvents    PatrolEvent[]

  voiLinks IncidentVOILink[]

  @@index([createdByUserId])
  @@index([linkedPatrolId])
  @@index([sector])
  @@index([status])
  @@index([severity])
  @@index([incidentType])
  @@index([reportedAt])
}

model PatrolEvent {
  id           String        @id @default(uuid())
  patrolId     String
  type         String
  incidentCode String?
  description  String?
  assistance   String?
  sceneActive  Boolean?
  createdAt    DateTime      @default(now())
  incidentId   String?
  incident     Incident?     @relation(fields: [incidentId], references: [id])
  patrol       PatrolSession @relation(fields: [patrolId], references: [id], onDelete: Cascade)

  voiLinks PatrolEventVOILink[]

  @@index([patrolId, createdAt])
  @@index([incidentId])
  @@index([type])
}

model Organisation {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sectors   Sector[]
}

model Sector {
  id             String             @id @default(uuid())
  name           String
  code           String
  isActive       Boolean            @default(true)
  organisationId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userAccess     UserSectorAccess[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@index([isActive])
}

model UserSectorAccess {
  id        String   @id @default(uuid())
  userId    String
  sectorId  String
  role      String
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canClose  Boolean  @default(false)
  canExport Boolean  @default(false)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sectorId])
  @@index([userId])
  @@index([sectorId])
}

model IntelligenceEntity {
  id                  String               @id @default(uuid())
  entityType          String
  displayName         String
  description         String?
  address             String?
  suburb              String?
  sector              String?
  latitude            Float?
  longitude           Float?
  riskLevel           String               @default("LOW")
  status              String               @default("ACTIVE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  voivehicleDetails   VOIVehicleDetails?
  patrolEventVOILinks PatrolEventVOILink[]

  incidentVOILinks IncidentVOILink[]
  outgoingLinks    IntelligenceLink[] @relation("FromEntity")
  incomingLinks    IntelligenceLink[] @relation("ToEntity")

  @@index([entityType])
  @@index([status])
  @@index([riskLevel])
  @@index([sector])
}

model VOIVehicleDetails {
  id                   String @id @default(uuid())
  intelligenceEntityId String @unique

  registrationNumber  String
  make                String?
  model               String?
  colour              String?
  vehicleType         String?
  distinguishingMarks String?
  notes               String?

  intelligenceEntity IntelligenceEntity @relation(fields: [intelligenceEntityId], references: [id], onDelete: Cascade)

  @@index([registrationNumber])
}

model PatrolEventVOILink {
  id                   String   @id @default(uuid())
  patrolEventId        String
  intelligenceEntityId String
  observationType      String? // Seen, Stopped, Followed, Reported
  notes                String?
  createdAt            DateTime @default(now())

  patrolEvent        PatrolEvent        @relation(fields: [patrolEventId], references: [id], onDelete: Cascade)
  intelligenceEntity IntelligenceEntity @relation(fields: [intelligenceEntityId], references: [id], onDelete: Cascade)

  @@index([patrolEventId])
  @@index([intelligenceEntityId])
}

model IncidentVOILink {
  id                   String   @id @default(uuid())
  incidentId           String
  intelligenceEntityId String
  roleInIncident       String? // Suspect vehicle, getaway vehicle, seen nearby
  notes                String?
  createdAt            DateTime @default(now())

  incident           Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  intelligenceEntity IntelligenceEntity @relation(fields: [intelligenceEntityId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([intelligenceEntityId])
}

model IntelligenceLink {
  id           String   @id @default(uuid())
  fromEntityId String
  toEntityId   String
  relationship String // owns, drives, seen_with, linked_to, etc
  strength     Int? // confidence level (1–10)
  notes        String?
  createdAt    DateTime @default(now())

  fromEntity IntelligenceEntity @relation("FromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   IntelligenceEntity @relation("ToEntity", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@index([fromEntityId])
  @@index([toEntityId])



}


model Member {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  firstName        String
  surname          String
  idNumber         String?
  cellNumber       String?
  email            String?
  address          String?
  suburb           String?
  sector           String?
  callSign         String?

  vettingStatus    String   @default("PENDING")
  isActive         Boolean  @default(true)

  nextOfKinName    String?
  nextOfKinPhone   String?
  medicalNotes     String?
  allergies        String?
  medication       String?
  bloodType        String?

  driversLicence   Boolean  @default(false)
  licenceCode      String?
  pdp              Boolean  @default(false)

  firstAid         Boolean  @default(false)
  fireTraining     Boolean  @default(false)
  radioTraining    Boolean  @default(false)
  patrolTraining   Boolean  @default(false)
  controlRoomTraining Boolean @default(false)

  notes            String?
}