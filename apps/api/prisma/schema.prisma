generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// CivitasWatch is moving toward sector-based multi-tenancy: operational and
/// register records should eventually belong to a sector such as S1, S2 or S3.
/// Sectors operate independently under Master Admin governance, while Central
/// Intelligence retains cross-sector analytical visibility.
/// Future master-register models are planned but intentionally not defined yet:
/// IncidentCode, IncidentSubcode, ServiceType, InfrastructureType, and
/// EmergencyContactType. These should become sector-scoped configuration tables
/// separate from operational records such as Incident, PatrolEvent, and patrol
/// reports.
///
/// Master template inheritance should allow Master Admin to publish shared
/// register templates that sectors can adopt, override, or extend locally while
/// preserving compatibility with the core CivitasWatch taxonomy.
model User {
  id                  String               @id @default(uuid())
  fullName            String
  email               String               @unique
  passwordHash        String
  role                String
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  incidentsCreated    Incident[]
  patrolSessions      PatrolSession[]
  patrolSessionCrew   PatrolSessionCrew[]
  prePatrolChecklists PrePatrolChecklist[]
  sectorAccess        UserSectorAccess[]
  member              Member?
}

model PrePatrolChecklist {
  id                   String          @id @default(uuid())
  userId               String
  patrolDate           DateTime
  vehicleInspected     Boolean         @default(false)
  safetyCheckCompleted Boolean         @default(false)
  notes                String?
  completedAt          DateTime        @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  callSignConfirmed    Boolean         @default(false)
  radioChecked         Boolean         @default(false)
  vehicleFuelLevel     String?
  vestChecked          Boolean         @default(false)
  patrolSessions       PatrolSession[]
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, patrolDate])
}

model Vehicle {
  id             String          @id @default(uuid())
  make           String
  type           String
  registration   String          @unique
  colour         String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  patrolSessions PatrolSession[]
}

/// A patrol session represents one vehicle/call-sign on duty, with a driver and
/// optional crew travelling under the same operational context.
model PatrolSession {
  id                      String              @id @default(uuid())
  userId                  String
  vehicleId               String?
  checklistId             String?
  callSign                String?
  sector                  String
  startTime               DateTime            @default(now())
  endTime                 DateTime?
  startKm                 Int
  endKm                   Int?
  totalKm                 Int?
  summary                 String?
  status                  String              @default("ACTIVE")
  vehicleMode             String              @default("REGISTERED")
  tempVehicleRegistration String?
  tempVehicleMake         String?
  tempVehicleModel        String?
  tempVehicleColour       String?
  tempVehicleType         String?
  tempVehicleCallSign     String?
  tempVehicleOwnerName    String?
  tempVehicleOwnerPhone   String?
  tempVehicleNotes        String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  editedAt                DateTime?
  editedBy                String?
  editCount               Int                 @default(0)
  isLocked                Boolean             @default(false)
  crew                    PatrolSessionCrew[]
  incidents               Incident[]
  patrolEvents            PatrolEvent[]
  checklist               PrePatrolChecklist? @relation(fields: [checklistId], references: [id])
  user                    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle                 Vehicle?            @relation(fields: [vehicleId], references: [id])

  @@index([userId, startTime])
  @@index([vehicleId, startTime])
  @@index([sector])
  @@index([status])
}

model PatrolSessionCrew {
  id               String    @id @default(uuid())
  patrolSessionId  String
  userId           String?
  memberId         String?
  role             String    @default("CREW")
  attendanceStatus String    @default("PRESENT")
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?
  creditGranted    Boolean   @default(true)
  notes            String?

  patrolSession PatrolSession @relation(fields: [patrolSessionId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  member        Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([patrolSessionId, userId])
  @@unique([patrolSessionId, memberId])
  @@index([patrolSessionId])
  @@index([userId])
  @@index([memberId])
  @@index([role])
}

model PatrolReportAuditLog {
  id           String   @id
  patrolId     String
  editedBy     String
  editedByRole String
  fieldName    String
  oldValue     String?
  newValue     String?
  editReason   String
  createdAt    DateTime @default(now())
}

/// Operational incident reports/responses are distinct from future
/// configuration registers such as Incident Codes and Incident Subcodes.
model Incident {
  id                String    @id @default(uuid())
  incidentCode      String    @unique
  title             String
  description       String?
  sector            String
  status            String
  severity          String
  source            String
  linkedPatrolId    String?
  createdByUserId   String
  reportedAt        DateTime
  occurredAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  incidentType      String?
  incidentCodeId    String?
  incidentSubcodeId String?
  street            String?
  suburb            String?

  createdBy          User                 @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  linkedPatrol       PatrolSession?       @relation(fields: [linkedPatrolId], references: [id])
  incidentCodeRef    IncidentCode?        @relation(fields: [incidentCodeId], references: [id])
  incidentSubcodeRef IncidentSubcode?     @relation(fields: [incidentSubcodeId], references: [id])
  patrolEvents       PatrolEvent[]
  incidentServices   IncidentServiceLog[]
  voiLinks           IncidentVOILink[]

  @@index([createdByUserId])
  @@index([linkedPatrolId])
  @@index([incidentCodeId])
  @@index([incidentSubcodeId])
  @@index([sector])
  @@index([status])
  @@index([severity])
  @@index([incidentType])
  @@index([reportedAt])
}

/// Patrol events are operational records. Assistance Requests are generated by
/// Patrol into the assistance field and managed by Control Room.
model PatrolEvent {
  id                String   @id @default(uuid())
  patrolId          String
  type              String
  incidentCode      String?
  description       String?
  assistance        String?
  sceneActive       Boolean?
  createdAt         DateTime @default(now())
  incidentId        String?
  incidentCodeId    String?
  incidentSubcodeId String?

  incident           Incident?            @relation(fields: [incidentId], references: [id])
  incidentCodeRef    IncidentCode?        @relation(fields: [incidentCodeId], references: [id])
  incidentSubcodeRef IncidentSubcode?     @relation(fields: [incidentSubcodeId], references: [id])
  patrol             PatrolSession        @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  voiLinks           PatrolEventVOILink[]

  @@index([patrolId, createdAt])
  @@index([incidentId])
  @@index([incidentCodeId])
  @@index([incidentSubcodeId])
  @@index([type])
}

/// Service records are configuration-style data for Control Room coordination.
/// Future configuration registers should also include Service Types,
/// Infrastructure Types, and Emergency Contact Types.
model Service {
  id        String   @id @default(uuid())
  name      String
  type      String
  phone     String?
  radio     String?
  sector    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidentLogs IncidentServiceLog[]

  @@index([type])
  @@index([sector])
  @@index([isActive])
}

/// Operational service coordination remains tied to incidents; Control Room
/// coordinates external services rather than Patrol bypassing it.
model IncidentServiceLog {
  id          String    @id @default(uuid())
  incidentId  String
  serviceId   String
  status      String
  refNumber   String?
  requestedAt DateTime?
  arrivedAt   DateTime?
  clearedAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([serviceId])
  @@index([status])
}

model Organisation {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sectors provide the future isolation boundary for both operational data and
/// configuration registers, while Master Admin retains governance across them.
/// Future IncidentCode, IncidentSubcode, ServiceType, InfrastructureType, and
/// EmergencyContactType records should be scoped to Sector, with optional links
/// back to shared Master Admin templates for inheritance/override behavior.
model Sector {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  name                  String
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  userAccess            UserSectorAccess[]
  incidentCodes         IncidentCode[]
  incidentSubcodes      IncidentSubcode[]
  serviceTypes          ServiceType[]
  infrastructureTypes   InfrastructureType[]
  emergencyContactTypes EmergencyContactType[]
}

model IncidentCode {
  id               String            @id @default(cuid())
  sectorId         String?
  code             String
  name             String
  priority         String            @default("Medium")
  active           Boolean           @default(true)
  templateSourceId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sector           Sector?           @relation(fields: [sectorId], references: [id])
  subcodes         IncidentSubcode[]
  incidents        Incident[]
  patrolEvents     PatrolEvent[]

  @@unique([sectorId, code])
  @@index([sectorId])
}

model IncidentSubcode {
  id               String        @id @default(cuid())
  sectorId         String?
  incidentCodeId   String
  subcode          String
  name             String
  active           Boolean       @default(true)
  templateSourceId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  sector           Sector?       @relation(fields: [sectorId], references: [id])
  incidentCode     IncidentCode  @relation(fields: [incidentCodeId], references: [id])
  incidents        Incident[]
  patrolEvents     PatrolEvent[]

  @@unique([incidentCodeId, subcode])
  @@index([sectorId])
  @@index([incidentCodeId])
}

model ServiceType {
  id                 String   @id @default(cuid())
  sectorId           String?
  type               String
  category           String   @default("Emergency")
  controlRoomManaged Boolean  @default(true)
  active             Boolean  @default(true)
  templateSourceId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  sector             Sector?  @relation(fields: [sectorId], references: [id])

  @@unique([sectorId, type])
  @@index([sectorId])
}

model InfrastructureType {
  id               String   @id @default(cuid())
  sectorId         String?
  type             String
  riskLevel        String   @default("Medium")
  requiresLocation Boolean  @default(true)
  active           Boolean  @default(true)
  templateSourceId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sector           Sector?  @relation(fields: [sectorId], references: [id])

  @@unique([sectorId, type])
  @@index([sectorId])
}

model EmergencyContactType {
  id               String   @id @default(cuid())
  sectorId         String?
  type             String
  escalationLevel  String   @default("Level 1")
  sectorSpecific   Boolean  @default(true)
  active           Boolean  @default(true)
  templateSourceId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sector           Sector?  @relation(fields: [sectorId], references: [id])

  @@unique([sectorId, type])
  @@index([sectorId])
}

model UserSectorAccess {
  id        String   @id @default(uuid())
  userId    String
  sectorId  String
  role      String
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canClose  Boolean  @default(false)
  canExport Boolean  @default(false)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sectorId])
  @@index([userId])
  @@index([sectorId])
}

model IntelligenceEntity {
  id                  String               @id @default(uuid())
  entityType          String
  displayName         String
  description         String?
  address             String?
  suburb              String?
  sector              String?
  latitude            Float?
  longitude           Float?
  riskLevel           String               @default("LOW")
  status              String               @default("ACTIVE")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  voivehicleDetails   VOIVehicleDetails?
  patrolEventVOILinks PatrolEventVOILink[]
  incidentVOILinks    IncidentVOILink[]
  outgoingLinks       IntelligenceLink[]   @relation("FromEntity")
  incomingLinks       IntelligenceLink[]   @relation("ToEntity")

  @@index([entityType])
  @@index([status])
  @@index([riskLevel])
  @@index([sector])
}

model VOIVehicleDetails {
  id                   String  @id @default(uuid())
  intelligenceEntityId String  @unique
  registrationNumber   String
  make                 String?
  model                String?
  colour               String?
  vehicleType          String?
  distinguishingMarks  String?
  notes                String?

  intelligenceEntity IntelligenceEntity @relation(fields: [intelligenceEntityId], references: [id], onDelete: Cascade)

  @@index([registrationNumber])
}

model PatrolEventVOILink {
  id                   String   @id @default(uuid())
  patrolEventId        String
  intelligenceEntityId String
  observationType      String?
  notes                String?
  createdAt            DateTime @default(now())

  patrolEvent        PatrolEvent        @relation(fields: [patrolEventId], references: [id], onDelete: Cascade)
  intelligenceEntity IntelligenceEntity @relation(fields: [intelligenceEntityId], references: [id], onDelete: Cascade)

  @@index([patrolEventId])
  @@index([intelligenceEntityId])
}

model IncidentVOILink {
  id                   String   @id @default(uuid())
  incidentId           String
  intelligenceEntityId String
  roleInIncident       String?
  notes                String?
  createdAt            DateTime @default(now())

  incident           Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  intelligenceEntity IntelligenceEntity @relation(fields: [intelligenceEntityId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([intelligenceEntityId])
}

model IntelligenceLink {
  id           String   @id @default(uuid())
  fromEntityId String
  toEntityId   String
  relationship String
  strength     Int?
  notes        String?
  createdAt    DateTime @default(now())

  fromEntity IntelligenceEntity @relation("FromEntity", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   IntelligenceEntity @relation("ToEntity", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@index([fromEntityId])
  @@index([toEntityId])
}

model Member {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName  String
  surname    String
  idNumber   String?
  cellNumber String?
  email      String?
  address    String?
  suburb     String?
  sector     String?
  callSign   String?

  vettingStatus String  @default("PENDING")
  isActive      Boolean @default(true)

  nextOfKinName  String?
  nextOfKinPhone String?
  medicalNotes   String?
  allergies      String?
  medication     String?
  bloodType      String?

  driversLicence Boolean @default(false)
  licenceCode    String?
  pdp            Boolean @default(false)

  firstAid            Boolean @default(false)
  fireTraining        Boolean @default(false)
  radioTraining       Boolean @default(false)
  patrolTraining      Boolean @default(false)
  controlRoomTraining Boolean @default(false)

  userId         String? @unique
  patrolApproved Boolean @default(false)
  patrolStatus   String  @default("NOT_PATROLLER")
  patrolNotes    String?

  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  patrolSessionCrew PatrolSessionCrew[]

  notes String?

  @@index([sector])
  @@index([isActive])
  @@index([patrolApproved])
  @@index([patrolStatus])
}
