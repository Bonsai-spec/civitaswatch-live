DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"
NODE_ENV="development"
PORT="4000"
CORS_ORIGINS="http://localhost:5173"

# Default local development uses relative API paths through the Vite proxy.
# Start the web app with:
# npm run dev --workspace apps/web -- --host 0.0.0.0
#
# Optional direct API mode for mobile testing:
# VITE_API_URL="http://YOUR_MAC_LAN_IP:4000"
# VITE_API_BASE_URL is also supported as a compatibility alias.
# Optional proxy target override:
# VITE_API_PROXY_TARGET="http://localhost:4000"
